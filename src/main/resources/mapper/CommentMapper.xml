<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crusader.stackleafserver.mapper.CommentMapper">

    <!-- 查询某篇文章的顶级评论（分页） -->
    <select id="selectTopComments" resultType="com.crusader.stackleafserver.model.entity.Comment">
        SELECT *
        FROM `comment`
        WHERE article_id = #{articleId}
          AND parent_id = 0
          AND status = 1
        ORDER BY create_time DESC
    </select>

    <!-- 查询某篇顶级评论下的所有子评论（楼中楼） -->
    <select id="selectChildComments" resultType="com.crusader.stackleafserver.model.entity.Comment">
        SELECT *
        FROM `comment`
        WHERE parent_id = #{parentId}
          AND status = 1
        ORDER BY create_time ASC
    </select>

</mapper>
